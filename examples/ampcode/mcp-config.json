{
  "mcpServers": {
    "ledgermind": {
      "command": "pnpm",
      "args": [
        "--dir",
        "../..",
        "--filter",
        "@ledgermind/mcp-server",
        "dev",
        "--binding-store",
        ".ledgermind/session-bindings.json",
        "--enable-write-tools"
      ],
      "env": {
        "DATABASE_URL": "postgres://user:pass@localhost:5432/ledgermind",
        "LEDGERMIND_DB_URL": "postgres://user:pass@localhost:5432/ledgermind",
        "LEDGERMIND_MCP_RUNTIME": "ampcode"
      }
    }
  }
}
