{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir ../.. exec ledgermind-claude-session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir ../.. exec ledgermind-claude-pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir ../.. exec ledgermind-claude-stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --dir ../.. exec ledgermind-claude-post-tool-use",
            "async": true
          }
        ]
      }
    ]
  }
}
