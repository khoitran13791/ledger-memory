{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_SQLITE_PATH=../../.ledgermind/memory.sqlite LEDGERMIND_MCP_BINDING_STORE=../../.ledgermind/session-bindings.json LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true pnpm --dir ../.. --filter @ledgermind/claude-code exec tsx src/commands/session-start.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_SQLITE_PATH=../../.ledgermind/memory.sqlite LEDGERMIND_MCP_BINDING_STORE=../../.ledgermind/session-bindings.json LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true pnpm --dir ../.. --filter @ledgermind/claude-code exec tsx src/commands/user-prompt-submit.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_SQLITE_PATH=../../.ledgermind/memory.sqlite LEDGERMIND_MCP_BINDING_STORE=../../.ledgermind/session-bindings.json LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true pnpm --dir ../.. --filter @ledgermind/claude-code exec tsx src/commands/pre-compact.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_SQLITE_PATH=../../.ledgermind/memory.sqlite LEDGERMIND_MCP_BINDING_STORE=../../.ledgermind/session-bindings.json pnpm --dir ../.. --filter @ledgermind/claude-code exec tsx src/commands/stop.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read|Grep|Glob|LS|Task",
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_SQLITE_PATH=../../.ledgermind/memory.sqlite LEDGERMIND_MCP_BINDING_STORE=../../.ledgermind/session-bindings.json LEDGERMIND_CLAUDE_ENABLE_TOOL_EVIDENCE=true LEDGERMIND_CLAUDE_ENABLE_ARTIFACT_INDEXING=true pnpm --dir ../.. --filter @ledgermind/claude-code exec tsx src/commands/post-tool-use.ts",
            "async": true
          }
        ]
      }
    ]
  }
}
