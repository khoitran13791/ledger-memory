{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true ledgermind-claude-session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true ledgermind-claude-user-prompt-submit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_CLAUDE_ENABLE_CONTINUITY_INJECTION=true ledgermind-claude-pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ledgermind-claude-stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read|Grep|Glob|LS|Task",
        "hooks": [
          {
            "type": "command",
            "command": "LEDGERMIND_CLAUDE_ENABLE_TOOL_EVIDENCE=true LEDGERMIND_CLAUDE_ENABLE_ARTIFACT_INDEXING=true ledgermind-claude-post-tool-use",
            "async": true
          }
        ]
      }
    ]
  }
}
