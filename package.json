{
  "name": "ledger-memory",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "mcp:dev": "pnpm --filter @ledgermind/mcp-server dev",
    "mcp:smoke": "pnpm --filter @ledgermind/mcp-server smoke",
    "claude:hook:precompact:smoke": "pnpm --filter @ledgermind/claude-code smoke:precompact",
    "claude:hook:stop:smoke": "pnpm --filter @ledgermind/claude-code smoke:stop",
    "benchmark:longmemeval": "pnpm --filter @ledgermind/benchmark-longmemeval benchmark",
    "benchmark:longmemeval:smoke": "pnpm --filter @ledgermind/benchmark-longmemeval benchmark:smoke",
    "benchmark:locomo": "pnpm --filter @ledgermind/benchmark-locomo benchmark",
    "benchmark:locomo:smoke": "pnpm --filter @ledgermind/benchmark-locomo benchmark:smoke",
    "benchmark:locomo:canary": "pnpm --filter @ledgermind/benchmark-locomo benchmark:canary",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.8.11",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
